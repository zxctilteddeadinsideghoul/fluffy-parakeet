# Backend
BACKEND_ENVIRONMENT=development
BACKEND_DATABASE_URL=sqlite+aiosqlite:///./app/data/app.db
BACKEND_PRESENCE_TTL_HOURS=4
BACKEND_LOG_LEVEL=INFO

# Frontend (browser-visible, never put secrets behind VITE_)
# API calls go to /api on the dev server, which proxies to BACKEND_ORIGIN.
# Leave VITE_API_BASE_URL unset unless you target a backend that sends CORS headers.
BACKEND_ORIGIN=http://localhost:8000
# Dev-only: sent as X-Dev-User-Id until real authentication exists.
# The backend accepts it only when BACKEND_ENVIRONMENT=development.
VITE_DEV_USER_ID=
